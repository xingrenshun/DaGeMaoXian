/tt-minigame/
/log/
/Logs/
[Bb]uilds*.log

# ---- IDE / 编辑器工程文件（Unity 自动重新生成）----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
