*.userprefs
*.ide

# ---- OS 杂物 ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# ---- Unity 崩溃报告 ----
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# ---- 排查过程留下的临时探测文件 ----
/.probe*.txt
/.recent.txt

